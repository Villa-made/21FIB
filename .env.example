# Valores públicos del frontend (nunca poner aquí service_role ni claves de IA).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
# Turnstile site key (pública)
VITE_TURNSTILE_SITE_KEY=<site-key>
# Solo desarrollo: usa fixtures del contrato v1 en lugar del API real. Ignorado en build de producción.
VITE_USE_FIXTURES=true
