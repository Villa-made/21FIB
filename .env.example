# ============================================================================
# FRONT (Vite) — copy to .env.local. ONLY these three variables may use the
# VITE_ prefix: Vite embeds every VITE_* variable in the public JS bundle.
# Never prefix a secret with VITE_.
# ============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=

# ============================================================================
# BACKEND TESTS (Deno) — copy to .env.test (git-ignored). No VITE_ prefix:
# tests read these exact names; with the prefix the DB tests are skipped.
# ============================================================================
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # DEV project only; never in .env.local or the front

# ============================================================================
# EDGE FUNCTION SECRETS — names only. Set them as Supabase Edge Function
# secrets (supabase secrets set ...), never in the repo or the front.
# ============================================================================
# ALLOWED_ORIGINS=             # e.g. http://localhost:5173,https://<project>.pages.dev
# TURNSTILE_SECRET_KEY=        # Cloudflare Turnstile widget secret (server-side siteverify)
# REPORT_RATE_SALT=            # random secret salt for the report rate-limit key
# CLOUDFLARE_ACCOUNT_ID=       # Workers AI (evidence validator)
# CLOUDFLARE_AUTH_TOKEN=       # API token restricted to Workers AI permissions

# ============================================================================
# AI PROVIDER SPIKE (T02.1, local only) — no VITE_ prefix.
# Local-only, non-identifying test images. Keep this directory ignored by Git.
# ============================================================================
# AI_SPIKE_RELEVANT_IMAGE=tests/ai/private-fixtures/relevant.jpg
# AI_SPIKE_RELEVANT_DESCRIPTION=
# AI_SPIKE_IRRELEVANT_IMAGE=tests/ai/private-fixtures/irrelevant.jpg
# AI_SPIKE_IRRELEVANT_DESCRIPTION=
